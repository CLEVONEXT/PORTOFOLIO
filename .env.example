# ═══════════════════════════════════════════════════
# Clevonext.Dev — Environment template
# Copy to `.env` (local) and fill in real values. Never commit `.env`.
# ═══════════════════════════

# ── App ────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NODE_ENV="development"

# ── Database (Vercel Postgres / Supabase) ──────────────────────────────────
# Pooled connection (used by the app at runtime)
DATABASE_URL="postgres://user:password@host:5432/clevonext?sslmode=require"
# Direct connection (used by Prisma schema sync/migrations)
DATABASE_URL_UNPOOLED="postgres://user:password@host:5432/clevonext?sslmode=require"

# ── Auth.js / NextAuth ─────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-string"
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

# ── Seed admin account (npm run db:seed) ───────────────────────────────────
SEED_ADMIN_EMAIL="admin@clevonext.dev"
SEED_ADMIN_PASSWORD="Clevonext#2026"

# ── Media storage: Vercel Blob ─────────────────────────────────────────────
# Leave empty to fall back to local `public/uploads` during development.
BLOB_READ_WRITE_TOKEN=""

# ── Email delivery (contact form) via Resend ───────────────────────────────
RESEND_API_KEY=""
CONTACT_TO_EMAIL="your-gmail@gmail.com"
CONTACT_FROM_EMAIL="Clevonext.Dev <onboarding@resend.dev>"
SITE_EMAIL="hello@clevonext.dev"

# ── Spotify Web API (admin playlist search) ────────────────────────────────
# Create an app at https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=""
SPOTIFY_CLIENT_SECRET=""

# ── Desktop / mobile build target ──────────────────────────────────────────
# Set to "desktop" to emit a Next.js standalone build for Electron packaging.
BUILD_TARGET=""